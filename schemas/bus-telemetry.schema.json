{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-sim.local/schemas/bus-telemetry.schema.json",
  "title": "BusTelemetryEvent",
  "description": "Sentetik otobus simulatorunden uretilecek ham telemetri eventi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "bus_id",
    "line_id",
    "route_direction",
    "lat",
    "lon",
    "speed_kmh",
    "next_stop_id",
    "next_stop_name",
    "boarding_count"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Her event icin tekil kimlik."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC zaman damgasi."
    },
    "bus_id": {
      "type": "string",
      "pattern": "^BUS_[0-9]{3}_[0-9]{2}$",
      "description": "Otobus kimligi. Ornek: BUS_510_01"
    },
    "line_id": {
      "type": "string",
      "pattern": "^LINE_[0-9]{3}$",
      "description": "Hat kimligi. Ornek: LINE_510"
    },
    "route_direction": {
      "type": "string",
      "enum": ["outbound", "inbound"],
      "description": "Rota yonu."
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Enlem."
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Boylam."
    },
    "speed_kmh": {
      "type": "number",
      "minimum": 0,
      "maximum": 130,
      "description": "Anlik hiz."
    },
    "next_stop_id": {
      "type": "string",
      "pattern": "^STOP_[A-Z0-9_]+$",
      "description": "Siradaki durak kimligi."
    },
    "next_stop_name": {
      "type": "string",
      "minLength": 1,
      "description": "Siradaki durak adi."
    },
    "boarding_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "description": "Bu eventte gozlenen kart basim sayisi."
    }
  }
}
